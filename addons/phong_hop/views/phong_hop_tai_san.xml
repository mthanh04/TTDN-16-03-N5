<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree -->
        <record id="view_phong_hop_tai_san_tree" model="ir.ui.view">
            <field name="name">phong.hop.tai.san.tree</field>
            <field name="model">phong_hop_tai_san</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="tai_san_id"/>
                    <field name="name"/>
                    <field name="phong_hop_id"/>
                    <field name="so_luong"/>
                    <field name="tinh_trang"/>
                    <field name="la_tai_san_co_dinh"/>
                </tree>
            </field>
        </record>

        <!-- Form -->
        <record id="view_phong_hop_tai_san_form" model="ir.ui.view">
            <field name="name">phong.hop.tai.san.form</field>
            <field name="model">phong_hop_tai_san</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Thông tin cơ bản">
                                <field name="tai_san_id" 
                                       options="{'no_create': True, 'no_create_edit': True}"
                                       placeholder="Chọn tài sản từ module tài sản..."/>
                                <field name="name" readonly="1"/>
                                <field name="phong_hop_id"/>
                                <field name="so_luong"/>
                            </group>
                            <group string="Trạng thái">
                                <field name="tinh_trang"/>
                                <field name="la_tai_san_co_dinh"/>
                                <field name="ghi_chu" placeholder="Ghi chú về tài sản..."/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_phong_hop_tai_san" model="ir.actions.act_window">
            <field name="name">Tài sản phòng họp</field>
            <field name="res_model">phong_hop_tai_san</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
