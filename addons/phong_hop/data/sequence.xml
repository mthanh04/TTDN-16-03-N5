<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence cho mã phòng họp -->
        <record id="seq_phong_hop" model="ir.sequence">
            <field name="name">Mã phòng họp</field>
            <field name="code">phong_hop</field>
            <field name="prefix">PH-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <!-- Sequence cho Phiếu mượn phòng -->
        <record id="seq_phieu_muon_phong" model="ir.sequence">
            <field name="name">Phiếu mượn phòng</field>
            <field name="code">phieu_muon_phong</field>
            <field name="prefix">PM/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo>
