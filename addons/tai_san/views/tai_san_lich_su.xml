<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_tai_san_lich_su_tree" model="ir.ui.view">
            <field name="name">tai_san_lich_su.tree</field>
            <field name="model">tai_san_lich_su</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ngay"/>
                    <field name="tai_san_id"/>
                    <field name="hanh_dong"/>
                    <field name="nguoi_muon_id"/>
                    <field name="ngay_muon"/>
                    <field name="ngay_tra"/>
                    <field name="phieu_muon_id"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_tai_san_lich_su_form" model="ir.ui.view">
            <field name="name">tai_san_lich_su.form</field>
            <field name="model">tai_san_lich_su</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Thông tin cơ bản">
                                <field name="tai_san_id"/>
                                <field name="phieu_muon_id"/>
                                <field name="hanh_dong"/>
                                <field name="ngay"/>
                                <field name="user_id"/>
                            </group>
                            <group string="Thời gian mượn/trả">
                                <field name="nguoi_muon_id"/>
                                <field name="ngay_muon"/>
                                <field name="ngay_du_kien_tra"/>
                                <field name="ngay_tra"/>
                            </group>
                        </group>
                        <group string="Ghi chú">
                            <field name="ghi_chu" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_tai_san_lich_su_search" model="ir.ui.view">
            <field name="name">tai_san_lich_su.search</field>
            <field name="model">tai_san_lich_su</field>
            <field name="arch" type="xml">
                <search>
                    <field name="tai_san_id"/>
                    <field name="nguoi_muon_id"/>
                    <field name="hanh_dong"/>
                    
                    <filter string="Mượn" name="filter_muon" domain="[('hanh_dong', '=', 'muon')]"/>
                    <filter string="Trả" name="filter_tra" domain="[('hanh_dong', '=', 'tra')]"/>
                    <filter string="Bảo trì" name="filter_bao_tri" domain="[('hanh_dong', '=', 'bao_tri')]"/>
                    <filter string="Thanh lý" name="filter_thanh_ly" domain="[('hanh_dong', '=', 'thanh_ly')]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Hành động" name="group_hanh_dong" context="{'group_by': 'hanh_dong'}"/>
                        <filter string="Tài sản" name="group_tai_san" context="{'group_by': 'tai_san_id'}"/>
                        <filter string="Người mượn" name="group_nguoi_muon" context="{'group_by': 'nguoi_muon_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_tai_san_lich_su" model="ir.actions.act_window">
            <field name="name">Lịch sử tài sản</field>
            <field name="res_model">tai_san_lich_su</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_filter_muon': True}</field>
        </record>
    </data>
</odoo>
