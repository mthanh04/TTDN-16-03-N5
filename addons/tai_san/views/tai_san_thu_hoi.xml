<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tai_san_thu_hoi_tree" model="ir.ui.view">
        <field name="model">tai_san_thu_hoi</field>
        <field name="arch" type="xml">
            <tree>
                <field name="tai_san_id"/>
                <field name="ngay_thu_hoi"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_tai_san_thu_hoi_form" model="ir.ui.view">
        <field name="model">tai_san_thu_hoi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="tai_san_id"/>
                        <field name="ngay_thu_hoi"/>
                        <field name="ly_do"/>
                        <field name="state" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_done" type="object"
                            string="Thu hồi"
                            states="draft"
                            class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tai_san_thu_hoi" model="ir.actions.act_window">
        <field name="name">Thu hồi tài sản</field>
        <field name="res_model">tai_san_thu_hoi</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
