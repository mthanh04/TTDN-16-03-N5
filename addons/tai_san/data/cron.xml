<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action: Tính khấu hao tự động hàng tháng -->
        <record id="ir_cron_tinh_khau_hao" model="ir.cron">
            <field name="name">Tính khấu hao tự động</field>
            <field name="model_id" ref="model_khau_hao_tai_san"/>
            <field name="state">code</field>
            <field name="code">model.action_tinh_khau_hao_tu_dong()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(months=1)).replace(day=1, hour=0, minute=0, second=0)"/>
        </record>
        
        <!-- Scheduled Action: Kiểm tra phiếu mượn quá hạn hàng ngày -->
        <record id="ir_cron_check_qua_han" model="ir.cron">
            <field name="name">Kiểm tra phiếu mượn quá hạn</field>
            <field name="model_id" ref="model_phieu_muon_tai_san"/>
            <field name="state">code</field>
            <field name="code">model.action_check_qua_han()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
