<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Category -->
        <record id="module_category_hr" model="ir.module.category">
            <field name="name">Nhân sự</field>
            <field name="description">Quản lý nhân sự</field>
            <field name="sequence">10</field>
        </record>

        <!-- User -->
        <record id="group_hr_user" model="res.groups">
            <field name="name">Nhân viên</field>
            <field name="category_id" ref="module_category_hr"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager -->
        <record id="group_hr_manager" model="res.groups">
            <field name="name">Trưởng phòng</field>
            <field name="category_id" ref="module_category_hr"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_user'))]"/>
        </record>

        <!-- Admin (KHÔNG kế thừa user để tránh record rule) -->
        <record id="group_hr_admin" model="res.groups">
            <field name="name">Quản trị nhân sự</field>
            <field name="category_id" ref="module_category_hr"/>
            <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        </record>

    </data>
</odoo>
