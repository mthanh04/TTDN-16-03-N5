<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Nhân viên chỉ thấy chính mình -->
        <record id="nhan_vien_user_rule" model="ir.rule">
            <field name="name">Nhân viên chỉ xem chính mình</field>
            <field name="model_id" ref="model_nhan_vien"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_user'))]"/>
        </record>

        <!-- Trưởng phòng thấy nhân viên trong phòng ban -->
        <record id="nhan_vien_manager_rule" model="ir.rule">
            <field name="name">Trưởng phòng xem nhân viên phòng mình</field>
            <field name="model_id" ref="model_nhan_vien"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('phong_ban_id.truong_phong_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_manager'))]"/>
        </record>

        <!-- KHÔNG có rule cho Admin -->
    </data>
</odoo>
